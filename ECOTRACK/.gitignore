# ==============================================================================
# ECOTRACK - Production .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT TO GIT)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.cert

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit Tests & Coverage
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# Logs & Local Databases
logs/
*.log
*.sqlite
*.sqlite3
*.db

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Node / Build Tools (if applicable)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Antigravity / Agent Scratch & System Logs
.gemini/
.system_generated/
scratch/
